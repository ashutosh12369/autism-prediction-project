{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "▷ Launch ASD Clinical App (Streamlit)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/run.py",
            "console": "integratedTerminal"
        },
        {
            "name": "▷ Run Training & Benchmark (train.py)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/train.py",
            "console": "integratedTerminal"
        },
        {
            "name": "▷ Run All Unit Tests (pytest)",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": ["-v"],
            "console": "integratedTerminal"
        }
    ]
}
